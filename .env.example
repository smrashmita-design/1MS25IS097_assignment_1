# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# This key is read by the Node.js server ONLY. It is never exposed to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3001

# Preferred Gemini Model (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash
